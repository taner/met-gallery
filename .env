# Public configuration for Met Gallery, loaded at start-up by flutter_dotenv.
#
# This file is bundled into the app as an asset, so anyone can read it. It
# holds addresses and nothing secret (the API is keyless), which is why it is
# committed. A missing or blank value falls back to the default in
# lib/env.dart.

# Root of the Met's Collection API, without a version segment: search is on
# v1.1 and objects are on v1 (see collection_remote_repository.dart).
COLLECTION_BASE_URL=https://collectionapi.metmuseum.org/public/collection

# Where an artwork's public page lives on the museum's site. Only used when
# an object record arrives without a usable link of its own.
OBJECT_PAGE_BASE_URL=https://www.metmuseum.org/art/collection/search
